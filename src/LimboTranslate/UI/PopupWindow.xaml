<Window x:Class="LimboTranslate.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="520"
        MinWidth="300"
        Opacity="0"
        FontFamily="Segoe UI"
        FontSize="13"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1">
        <StackPanel Margin="10,8,10,8">

            <Grid>
                <TextBlock x:Name="ProviderText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource AccentBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SpeakButton"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Озвучить"
                            Content="&#x1F50A;"
                            Click="SpeakButton_Click" />
                    <Button x:Name="CopyButton"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Копировать перевод"
                            Content="&#x29C9;"
                            Click="CopyButton_Click" />
                    <Button x:Name="ExpandButton"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Открыть в главном окне"
                            Content="&#x2922;"
                            Click="ExpandButton_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Закрыть"
                            Content="&#x2715;"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="SourceTextBlock"
                       Margin="0,6,0,0"
                       MaxHeight="60"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource SubtleTextBrush}" />

            <Border Height="1"
                    Margin="0,6,0,6"
                    Background="{StaticResource BorderBrush2}" />

            <TextBlock x:Name="TranslationTextBlock"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" />

            <TextBlock x:Name="TranscriptionTextBlock"
                       Margin="0,4,0,0"
                       FontSize="12"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{StaticResource SubtleTextBrush}" />

            <TextBlock x:Name="DictionaryTextBlock"
                       Margin="0,6,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{StaticResource SubtleTextBrush}" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="CopyActionButton"
                        Height="26"
                        Padding="10,0"
                        Content="Копировать"
                        Foreground="White"
                        BorderThickness="0"
                        Background="{StaticResource AccentBrush}"
                        Click="CopyButton_Click" />
                <Button x:Name="MoreActionButton"
                        Height="26"
                        Margin="6,0,0,0"
                        Padding="10,0"
                        Content="Ещё"
                        Click="ExpandButton_Click" />
            </StackPanel>

            <TextBlock x:Name="FooterTextBlock"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}" />

        </StackPanel>
    </Border>
</Window>
