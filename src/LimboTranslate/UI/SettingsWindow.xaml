<Window x:Class="LimboTranslate.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="480"
        Height="520"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="26" />
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource GroupBorder}">
                    <StackPanel>
                        <TextBlock Text="ЯЗЫКИ" Style="{StaticResource GroupTitle}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Исходный язык" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SourceLanguageBox" Grid.Column="1" DisplayMemberPath="Value" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Язык перевода" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TargetLanguageBox" Grid.Column="1" DisplayMemberPath="Value" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupBorder}">
                    <StackPanel>
                        <TextBlock Text="СЕРВИСЫ" Style="{StaticResource GroupTitle}" />
                        <StackPanel x:Name="ProvidersPanel" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Основной сервис" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ActiveProviderBox" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupBorder}">
                    <StackPanel>
                        <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource GroupTitle}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Перевести выделенное" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HotkeyTranslateBox" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Озвучить выделенное" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HotkeySpeakBox" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Главное окно" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HotkeyMainWindowBox" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                        </Grid>
                        <CheckBox x:Name="PopupEnabledCheck" Content="Всплывающее окно по двойному Ctrl" />
                        <CheckBox x:Name="MouseSelectionCheck" Content="Переводить при выделении мышью" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupBorder}">
                    <StackPanel>
                        <TextBlock Text="ПРОЧЕЕ" Style="{StaticResource GroupTitle}" />
                        <CheckBox x:Name="AutoStartCheck" Content="Запускать вместе с Windows" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Записей в истории" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HistoryLimitBox" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Сохранить" Width="100" Click="SaveButton_Click" />
            <Button Content="Отмена" Width="100" Margin="8,0,0,0" Click="CancelButton_Click" />
        </StackPanel>

    </Grid>
</Window>
