<Window x:Class="LimboTranslate.UI.SelectionIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        ShowActivated="False"
        Opacity="0"
        FontFamily="Segoe UI">

    <Border x:Name="RootBorder"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1"
            CornerRadius="4"
            Width="26"
            Height="26"
            Cursor="Hand"
            ToolTip="Перевести выделенный текст"
            MouseLeftButtonUp="Root_MouseLeftButtonUp"
            MouseEnter="Root_MouseEnter"
            MouseLeave="Root_MouseLeave">
        <Image Source="pack://application:,,,/Assets/logo.png"
               Width="18"
               Height="18"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Border>
</Window>
